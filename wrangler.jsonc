{
  "name": "software-metrics",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "sqm.josxa.dev/*",
      "zone_name": "josxa.dev"
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
